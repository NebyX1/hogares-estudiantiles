FLASK_ENV=production
APPLICATION_YEAR=2027
SESSION_COOKIE_SECURE=true
SECRET_KEY=generate-a-random-secret-of-at-least-32-characters
JWT_SECRET_KEY=generate-a-different-random-secret
DATA_ENCRYPTION_KEY=generate-with-python-cryptography-fernet
FILE_ENCRYPTION_KEY=generate-a-second-fernet-key
DB_HOST=database
DB_PORT=3306
DB_NAME=hogares_db
DB_USER=hogares
DB_PASSWORD=replace-me
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=https://solicitudes.example.uy
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me-with-a-long-random-value
MINIO_SECURE=false
MINIO_BUCKET_NAME=hogares-estudiantiles-documentos
TRUST_PROXY=true
FORCE_HTTPS=false
RUN_MIGRATIONS=true
PORT=5000
GUNICORN_WORKERS=2
GUNICORN_THREADS=4
APP_NAME=Hogares Estudiantiles
MAIL_SERVER=smtp.example.uy
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=notifications@example.uy
MAIL_PASSWORD=replace-me
MAIL_DEFAULT_SENDER=notifications@example.uy
